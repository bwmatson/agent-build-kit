# Machine-level settings for this planning repo. Copy to `.env`; it is
# ignored by git. Every value here is per machine or secret — what describes
# the workspace (repos, owners, deploy rules) is abk.yaml, which is committed.
# Facts about this installation's own stack (an agent command, local ports, a home
# variable) belong here too, read by `from: env-file` entries, and words that must
# never be public go in `scrub.local`; both stay ignored.
#
# Variables are read with the ABK_ prefix (see agent_build_kit.settings).

# One GitHub token for every `gh` call, instead of the per-owner lookup
# through `gh auth token --user <owner>`. Leave unset to use the lookup.
#GH_TOKEN=

# The address GitHub calls go to, for GitHub Enterprise or a stand-in host. On an
# Enterprise host set GH_TOKEN too: the per-owner lookup asks github.com.
#ABK_GITHUB_API_URL=

# Where per-unit worktrees are checked out on this machine, overriding
# abk.yaml's planning.worktree_root. Never inside the planning repo.
#ABK_WORKTREE_ROOT=

# The OpenSpec CLI version run through npx.
#ABK_OPENSPEC_VERSION=

# The Claude Code account this installation runs on: its config directory, an
# absolute path. CLAUDE_CONFIG_DIR is accepted in its place. Unset means the
# default account (the .claude directory
# in your home directory). `abk doctor` says which name and place supplied it.
#ABK_CLAUDE_HOME=

# Per-machine overrides of abk.yaml's `models`.
#ABK_IMPLEMENT_MODEL=
#ABK_REWORK_MODEL=
#ABK_REVIEW_MODEL=
#ABK_REWORK_REVIEW_MODEL=

# Telemetry (OpenTelemetry traces and metrics over OTLP/HTTP), off by default.
# Set the switch and an endpoint; the per-signal lines override the shared one.
#ABK_OTEL_ENABLED=true
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
#OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
