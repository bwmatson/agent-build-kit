# Machine-local settings and secrets (see .env.example).
.env

# Raw model output from the scheduled tracks.
.last-runs/

# Locks and per-run scratch under the state directory. units.json and the
# tracks' run logs beside it are committed; the locks are not.
runs/*.lock
runs/locks/
# A file per unit run, named for the unit; the unit's record names the latest.
runs/unit-logs/
# One line per agent call: the usage ledger (in the state directory; move this line
# if planning.state_dir is changed).
runs/usage-ledger.jsonl
# One line per change of a unit's reason for waiting (same note).
runs/decisions.jsonl
# One line per use of the usage endpoint, kept a week (same note).
runs/usage-calls.jsonl
# The originals `abk redact-history --apply` keeps beside what it rewrites; they hold the
# secrets (same note).
runs/**/*.pre-redact
*.pre-redact

# Words that identify this installation, for `abk scrub-check` (one per line). Never committed:
# a list of what must not be public would itself be the leak.
scrub.local

# Local tooling.
__pycache__/
*.pyc
.venv/
node_modules/
