# Machine-local settings and secrets (see .env.example).
.env

# Raw model output from the scheduled tracks.
.last-runs/

# Locks and per-run scratch under the state directory. units.json and the
# tracks' run logs beside it are committed; the locks are not.
runs/*.lock
runs/locks/
# A file per unit run, named for the unit; the unit's record names the latest.
runs/unit-logs/
# The runtime's last policy check, reused by `abk doctor` and `abk init`
# (in the state directory; move this line if planning.state_dir is changed).
runs/policy-check.json
# One line per agent call: the usage ledger (same note: move this line if
# planning.state_dir is changed).
runs/usage-ledger.jsonl

# Local tooling.
__pycache__/
*.pyc
.venv/
node_modules/
